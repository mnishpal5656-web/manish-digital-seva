function render(){let q=document.getElementById('search').value.trim().toLowerCase();let f=filter.value;let rows=services.filter(s=>(!f||s.category===f)&&(!q||(s.name+' '+s.category).toLowerCase().includes(q)));document.getElementById('count').textContent=`${rows.length} सेवाएँ`;document.getElementById('listTitle').textContent=f?`📋 ${f}`:'📋 सभी ऑनलाइन सेवाएँ';let box=document.getElementById('cards');box.innerHTML='';if(!rows.length){box.innerHTML='<div class="empty">कोई सेवा नहीं मिली। दूसरा नाम खोजें।</div>';return}rows.forEach(s=>{let msg=`Namaste, mujhe ${s.name} ke liye booking karani hai. Kripya jankari dein.`;let wa='https://wa.me/916260988021?text='+encodeURIComponent(msg);let el=document.createElement('article');el.className='card';el.innerHTML=`<span class="tag">${s.category}</span><h3>${s.name}</h3><p>इस सेवा की पात्रता, जरूरी दस्तावेज और प्रक्रिया जानने के लिए WhatsApp पर संपर्क करें।</p><div class="actions"><a class="btn info" href="${wa}" target="_blank">जानकारी लें</a><a class="btn wa" href="${wa}" target="_blank">🟢 बुक करें</a></div>`;box.append(el)})}
document.getElementById('search').addEventListener('input',render);filter.addEventListener('change',()=>{selected=filter.value;render()});render();
</script></body></html>
